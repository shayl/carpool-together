# Use values from the isolated Carpool Together Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ or commit its value.
SUPABASE_SECRET_KEY=
# One-time secret used to protect initial group setup.
BOOTSTRAP_SECRET=
# Random server-only value used to hash login rate-limit identifiers.
AUTH_RATE_LIMIT_SECRET=
# Web Push application server keys. The public key is safe for browser use.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://carpool-together.example
# Shared only between GitHub Actions and the reminder dispatch endpoint.
CRON_SECRET=
# Optional. Bounding box (lon_min,lat_min,lon_max,lat_max) used to rank nearby
# address suggestions first. Israel: 34.2,29.4,35.9,33.4
ADDRESS_SUGGEST_BBOX=
